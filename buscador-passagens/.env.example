# Copie para .env e preencha. NUNCA faça commit do arquivo .env.

# --- Fontes de preço (configure pelo menos uma) ---
# Travelpayouts / Aviasales Data API (gratuita): https://www.travelpayouts.com -> Tools -> API
TRAVELPAYOUTS_TOKEN=
# SerpApi Google Flights (plano grátis ~250 buscas/mês): https://serpapi.com
SERPAPI_KEY=

# --- E-mail (Gmail: crie uma "Senha de app" em https://myaccount.google.com/apppasswords) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=seu-email@gmail.com
SMTP_PASS=senha-de-app-de-16-letras
MAIL_FROM=Buscador de Passagens <seu-email@gmail.com>
MAIL_TO=seu-email@gmail.com

# Se o servidor bloquear SMTP (erro ETIMEDOUT): tente SMTP_PORT=587; se continuar, use o Resend (envio por HTTPS).
# Crie a chave grátis em https://resend.com/api-keys (cadastre-se com o MESMO e-mail do MAIL_TO).
RESEND_API_KEY=

# Fuso horário usado pelo agendamento
TZ=America/Sao_Paulo

# MOCK=1 usa dados de exemplo (para testar o e-mail sem chave de API)
MOCK=0
# FORCE_EMAIL=1 manda e-mail mesmo sem novidade (útil para testar)
FORCE_EMAIL=0
